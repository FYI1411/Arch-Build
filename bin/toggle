#!/bin/bash

# Toggle waybar and live wallpaper (mpvpaper)
if pgrep -x "waybar" > /dev/null || pgrep -x "mpvpaper" > /dev/null; then
    killall waybar mpvpaper hyprpaper 2>/dev/null
else
    waybar > /dev/null 2>&1 &
    hyprpaper > /dev/null 2>&1 &
    # live wallpaper
    # livewp > /dev/null 2>&1 &
fi
